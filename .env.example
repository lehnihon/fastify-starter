# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Database (matches compose.yaml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fastify_starter

# Auth
JWT_SECRET=change-me-super-secret-at-least-16-chars

# CORS (comma-separated origins, or * to allow any)
CORS_ORIGINS=*

# Under-pressure (event loop protection; 0 disables the memory limit —
# tune MAX_RSS_BYTES / MAX_HEAP_USED_BYTES to your host/container memory)
UNDER_PRESSURE_MAX_EVENT_LOOP_DELAY=1000
UNDER_PRESSURE_MAX_EVENT_LOOP_UTILIZATION=0.98
UNDER_PRESSURE_MAX_HEAP_USED_BYTES=0
UNDER_PRESSURE_MAX_RSS_BYTES=0
