NODE_ENV=test
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=silent

# Test database (matches db_test service in compose.yaml)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/fastify_starter_test

# Auth
JWT_SECRET=change-me-super-secret-at-least-16-chars

# CORS
CORS_ORIGINS=*

# Under-pressure
UNDER_PRESSURE_MAX_EVENT_LOOP_DELAY=1000
UNDER_PRESSURE_MAX_EVENT_LOOP_UTILIZATION=0.98
UNDER_PRESSURE_MAX_HEAP_USED_BYTES=0
UNDER_PRESSURE_MAX_RSS_BYTES=0
