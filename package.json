{
  "name": "fastify-starter",
  "version": "1.0.0",
  "description": "Fastify 5 + TypeScript + Drizzle + Swagger/OpenAPI starter",
  "type": "module",
  "main": "dist/server.js",
  "imports": {
    "#app/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "prepare": "husky"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{ts,js,json,md}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/request-context": "^7.0.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/under-pressure": "^9.1.0",
    "@scalar/fastify-api-reference": "^1.68.0",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.12.3",
    "fastify-metrics": "^14.1.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "openapi-types": "^12.1.3",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
